<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_department_view_kanban" model="ir.ui.view">
        <field name="name">hr.department.kanban.inherit</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr_expense.hr_department_view_kanban" />
        <field name="arch" type="xml">
            <div
                t-if="record.expenses_to_approve_count.raw_value > 0"
                position="attributes"
            >
                <attribute name="class" add="d-none" separator=" " />
            </div>
            <div t-if="record.expenses_to_approve_count.raw_value > 0" position="after">
                <div
                    t-if="record.expense_sheets_to_approve_count.raw_value > 0"
                    class="row ml32 g-0"
                    groups="hr_expense.group_hr_expense_team_approver"
                >
                    <a
                        name="%(action_hr_expense_sheet_department_to_approve)d"
                        class="col"
                        type="action"
                    >
                        <field
                        name="expense_sheets_to_approve_count"
                        groups="hr_expense.group_hr_expense_team_approver"
                    /> Expense Reports
                    </a>
                </div>
            </div>
            <a
                name="%(hr_expense.action_hr_expense_department_filtered)d"
                position="attributes"
            >
                <attribute name="class" add="d-none" separator=" " />
            </a>
            <a
                name="%(hr_expense.action_hr_expense_department_filtered)d"
                position="after"
            >
                <a
                    class="dropdown-item"
                    name="%(action_hr_expense_sheet_department_filtered)d"
                    type="action"
                    groups="hr_expense.group_hr_expense_team_approver"
                >
                    Expenses
                </a>
            </a>
        </field>
    </record>
</odoo>
