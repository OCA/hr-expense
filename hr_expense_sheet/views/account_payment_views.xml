<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_payment_form_inherit_expense" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="hr_expense.view_payment_form_inherit_expense" />
        <field name="arch" type="xml">
            <button name="action_open_expense" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="action_open_expense" position="after">
                <button
                    name="action_open_expense_report"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    type="object"
                    invisible="not expense_sheet_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Expense Report</span>
                    </div>
                </button>
            </button>
        </field>
    </record>
</odoo>
