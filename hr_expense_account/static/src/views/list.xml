<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="hr_expense_account.ListButtons"
        t-inherit="hr_expense.ListButtons"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//button[@t-on-click=&quot;() => this.onClick('action_post')&quot;]"
            position="replace"
        >
            <button
                t-if="displayPost()"
                class="d-none d-md-block btn btn-secondary"
                t-on-click="() => this.onClick('action_post')"
            >
                Create Journal Entries
            </button>
        </xpath>
    </t>
</templates>
