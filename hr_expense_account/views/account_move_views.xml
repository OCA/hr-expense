<odoo>
    <record id="account_move_view_form_inherit_hr_expense_account" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.hr_expense_account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='collapse_composition']"
                position="after"
            >
                <button
                    name="action_split_duplicate_line"
                    type="object"
                    icon="fa-copy"
                    string=""
                    title="Duplicate line"
                    class="btn btn-link"
                    style="width: 1%; white-space: nowrap;"
                    column_invisible="parent.state != 'draft' or parent.move_type != 'in_invoice'"
                />
            </xpath>
        </field>
    </record>
</odoo>
