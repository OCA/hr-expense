<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_expense" inherit_id="hr_expense.report_expense" active="True">
        <!-- hide the taxes column -->
        <xpath expr="//thead/tr/th[4]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//tbody/tr/td[4]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- subtotal rows -->
        <xpath
            expr="//div[hasclass('o_total')]/div/table/tbody/tr[1]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath
            expr="//div[hasclass('o_total')]/div/table/tbody/tr[2]"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
