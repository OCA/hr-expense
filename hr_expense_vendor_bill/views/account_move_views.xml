<odoo>
    <record id="view_move_form_inherit_expense_sheet" model="ir.ui.view">
        <field name="name">account.move.form.inherit.expense.sheet</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='narration']" position="before">
                <field name="expense_sheet_id" invisible="not expense_sheet_id" />
            </xpath>
        </field>
    </record>
</odoo>
