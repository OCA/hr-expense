<odoo>
    <record id="view_hr_expense_settings_inherit" model="ir.ui.view">
        <field name="name">hr.expense.config.settings.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[.//field[@name='expense_outstanding_account_id']]"
                position="inside"
            >
                <div class="row mt16 o_settings_container">
                    <div class="col-6 o_setting_box">
                        <label for="hr_expense_reimbursement_debit_account_id" />
                        <div class="text-muted">
                            Account used to debit employee reimbursements.
                        </div>
                        <field name="hr_expense_reimbursement_debit_account_id" />
                    </div>
                    <div class="col-6 o_setting_box">
                        <label for="hr_expense_reimbursement_credit_account_id" />
                        <div class="text-muted">
                            Account used to credit employee reimbursements.
                        </div>
                        <field name="hr_expense_reimbursement_credit_account_id" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
