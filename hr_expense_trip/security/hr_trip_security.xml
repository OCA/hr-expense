<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="hr_trip_rule_employee_own" model="ir.rule">
        <field name="name">Employee Own Trips</field>
        <field name="model_id" ref="model_hr_trip" />
        <field name="domain_force">[("employee_id.user_id", "=", user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="hr_trip_rule_manager_responsible" model="ir.rule">
        <field name="name">Manager Responsible Trips</field>
        <field name="model_id" ref="model_hr_trip" />
        <field
            name="domain_force"
        >["|", ("employee_id.expense_manager_id", "=", user.id), ("employee_id.parent_id.user_id", "=", user.id)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('hr_expense.group_hr_expense_team_approver')), Command.link(ref('hr_expense.group_hr_expense_user'))]"
        />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="hr_trip_rule_admin_all" model="ir.rule">
        <field name="name">Administrator All Trips</field>
        <field name="model_id" ref="model_hr_trip" />
        <field name="domain_force">[(1, "=", 1)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('hr_expense.group_hr_expense_manager'))]"
        />
    </record>
</odoo>
