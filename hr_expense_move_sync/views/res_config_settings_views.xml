<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.hr.expense.move.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='expenses_setting_container']" position="inside">
                <setting
                    string="Auto-sync expenses and journal entries"
                    help="Auto-regenerate draft journal entries when approved expenses are edited."
                >
                    <field name="auto_refresh_account_moves" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
