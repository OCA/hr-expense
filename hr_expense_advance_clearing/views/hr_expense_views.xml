<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">hr.expense.view.form</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <!-- Header -->
            <xpath expr="//header" position="inside">
                <button
                    name="open_clear_advance"
                    type="object"
                    string="Clear Advance"
                    class="oe_highlight"
                    invisible="not advance or state != 'paid' or clearing_residual == 0.0"
                />
                <button
                    name="action_pay"
                    type="object"
                    string="Pay"
                    class="oe_highlight"
                    groups="account.group_account_invoice"
                    invisible="not advance_id or state != 'posted'"
                />
                <button
                    name="action_return_advance"
                    type="object"
                    string="Return Advance"
                    invisible="not advance or state != 'paid' or clearing_residual &lt;= 0.0"
                    groups="account.group_account_user"
                />
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_clearings"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    type="object"
                    invisible="not advance"
                >
                    <field name="clearing_count" widget="statinfo" string="Clearings" />
                </button>
                <button
                    name="action_open_payment_return"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    type="object"
                    invisible="not advance"
                >
                    <field name="return_count" widget="statinfo" string="Return" />
                </button>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div name="options">
                    <span name="advance_option" class="d-inline-flex">
                        <field name="advance" readonly="1" />
                        <label for="advance" />
                    </span>
                </div>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="readonly">not is_editable or advance</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field
                    name="clearing_product_id"
                    invisible="not advance"
                    readonly="not is_editable"
                    placeholder="Optional clearing product is used during clear advance"
                />
            </xpath>
            <xpath expr="//label[@for='tax_ids']" position="before">
                <field
                    name="clearing_residual"
                    string="Remaining to Clear"
                    readonly="1"
                    invisible="not advance or not account_move_id"
                    class="fw-bold"
                />
            </xpath>
            <xpath expr="//field[@name='date']" position="before">
                <field
                    name="advance_id"
                    required="context.get('is_clearing', False)"
                    invisible="advance"
                    readonly="state != 'draft'"
                    domain="[('advance', '=', True), ('employee_id', '=', employee_id), ('clearing_residual', '>', 0.0)]"
                />
                <field
                    name="advance_residual"
                    readonly="1"
                    invisible="not advance_id"
                    class="fw-bold"
                />
                <field
                    name="amount_to_pay"
                    readonly="1"
                    invisible="not advance_id or amount_to_pay == 0.0"
                    class="fw-bold"
                />
            </xpath>
            <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                <attribute name="invisible">advance</attribute>
            </xpath>
        </field>
    </record>

    <!-- My Expenses: exclude advances and advance clearings. -->
    <record id="hr_expense.hr_expense_actions_my_all" model="ir.actions.act_window">
        <field name="domain">
            [('advance', '=', False), ('advance_id', '=', False)]
        </field>
    </record>

    <!-- My Advance -->
    <record id="action_my_advance" model="ir.actions.act_window">
        <field name="name">My Advances</field>
        <field name="res_model">hr.expense</field>
        <field name="view_mode">list,kanban,form,graph,pivot,activity</field>
        <field name="search_view_id" ref="hr_expense.hr_expense_view_search" />
        <field name="domain">[('advance', '=', True)]</field>
        <field name="context">{
            'search_default_my_advances': 1,
            'default_advance': True,
            }</field>
        <field name="help" type="html">
            <div class="o_view_nocontent_smiling_face">
                <p>No advance found. Let's create one!</p>
            </div>
            <p>
                Once you have created your advance, submit it to your manager
                who will validate it.
            </p>
        </field>
    </record>
    <!-- My Advances menuitem under My Expenses -->
    <menuitem
        id="menu_my_advance"
        name="My Advances"
        sequence="2"
        parent="hr_expense.menu_hr_expense_my_expenses"
        action="action_my_advance"
        groups="base.group_user"
    />

    <!-- My Clearings -->
    <record id="action_my_clearing" model="ir.actions.act_window">
        <field name="name">My Clearings</field>
        <field name="res_model">hr.expense</field>
        <field name="view_mode">list,kanban,form,graph,pivot,activity</field>
        <field name="search_view_id" ref="hr_expense.hr_expense_view_search" />
        <field name="domain">[('advance_id', '!=', False)]</field>
        <field name="context">{
            'search_default_my_clearings': 1,
            'default_advance': False,
            'is_clearing': 1,
            }</field>
        <field name="help" type="html">
            <div class="o_view_nocontent_smiling_face">
                <p>No clearing found. Let's create one!</p>
            </div>
            <p>
                Create an expense and select the advance to clear.
            </p>
        </field>
    </record>
    <menuitem
        id="menu_my_clearing"
        name="My Clearings"
        sequence="3"
        parent="hr_expense.menu_hr_expense_my_expenses"
        action="action_my_clearing"
        groups="base.group_user"
    />

    <!-- Search View -->
    <record id="hr_expense_view_search" model="ir.ui.view">
        <field name="name">hr.expense.view.search</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_open_expenses']" position="attributes">
                <attribute name="domain">
                    [('employee_id.user_id', '=', uid), ('advance', '=', False),
                    ('advance_id', '=', False)]
                </attribute>
            </xpath>
            <xpath expr="//filter[@name='my_open_expenses']" position="after">
                <filter
                    string="My Advances"
                    name="my_advances"
                    domain="[('employee_id.user_id', '=', uid), ('advance', '=', True)]"
                />
                <filter
                    string="My Clearings"
                    name="my_clearings"
                    domain="[('employee_id.user_id', '=', uid), ('advance_id', '!=', False)]"
                />
            </xpath>

            <xpath expr="//separator[1]" position="after">
                <filter
                    string="Advance (not cleared)"
                    name="advance_expense_uncleared"
                    domain="[('advance', '=', True), ('clearing_residual', '>', 0.0)]"
                />
                <separator />
            </xpath>
        </field>
    </record>

    <record id="hr_expense_view_expenses_analysis_tree" model="ir.ui.view">
        <field name="name">hr.expense.list</field>
        <field name="model">hr.expense</field>
        <field
            name="inherit_id"
            ref="hr_expense.hr_expense_view_expenses_analysis_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="advance_id" optional="show" />
            </xpath>
            <xpath expr="//field[@name='total_amount']" position="after">
                <field name="clearing_residual" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
