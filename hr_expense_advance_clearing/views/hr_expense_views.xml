<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_expense_view_search" model="ir.ui.view">
        <field name="name">hr.expense.view.search - advance_clearing</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search" />
        <field name="arch" type="xml">
            <separator position="after">
                <filter
                    string="Advance"
                    name="is_advance"
                    domain="[('expense_type', '=', 'advance')]"
                />
                <filter
                    string="Advance (not cleared)"
                    name="is_advance_uncleared"
                    domain="[('expense_type', '=', 'advance'), ('clearing_residual', '>', 0.0)]"
                />
                <filter
                    string="Clearing Expense"
                    name="is_clearing"
                    domain="[('clearing_advance_id', '!=', False)]"
                />
            </separator>
        </field>
    </record>

    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">hr.expense.view.form - advance_clearing</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <h1 position="after">
                <field name="expense_type" readonly="state != 'draft'" force_save="1" />
            </h1>
            <field name="product_id" position="attributes">
                <attribute
                    name="readonly"
                >state != 'draft' or expense_type == 'advance'</attribute>
                <attribute name="force_save">1</attribute>
            </field>
            <field name="product_id" position="after">
                <field
                    name="clearing_product_id"
                    invisible="expense_type != 'advance'"
                    placeholder="Optional clearing product for clear-advance lines"
                />
            </field>
            <xpath
                expr="//label[@for='product_id']/following-sibling::div[1]"
                position="after"
            >
                <field
                    name="clearing_advance_id"
                    invisible="expense_type == 'advance'"
                    readonly="state != 'draft'"
                />
                <field
                    name="advance_residual"
                    invisible="not clearing_advance_id"
                    readonly="1"
                />
                <field
                    name="clearing_residual"
                    invisible="expense_type != 'advance'"
                    readonly="1"
                />
            </xpath>
            <field name="analytic_distribution" position="attributes">
                <attribute name="invisible">expense_type == 'advance'</attribute>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_clearings"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    type="object"
                    invisible="expense_type != 'advance' or clearing_count == 0"
                >
                    <field name="clearing_count" widget="statinfo" string="Clearings" />
                </button>
                <button
                    name="action_view_returns"
                    class="oe_stat_button"
                    icon="fa-undo"
                    type="object"
                    invisible="expense_type != 'advance' or return_count == 0"
                >
                    <field name="return_count" widget="statinfo" string="Returns" />
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_return_advance"
                    type="object"
                    string="Return Advance"
                    invisible="expense_type != 'advance' or state != 'paid' or clearing_residual &lt;= 0.0"
                    groups="account.group_account_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
