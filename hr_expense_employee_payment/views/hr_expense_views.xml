<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">hr.expense.view.form</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button
                    name="action_open_conciliation_move"
                    class="oe_stat_button"
                    icon="fa-bars"
                    type="object"
                    invisible="not conciliation_move_id"
                    groups="account.group_account_invoice"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Conciliation Entry</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//header/button[@name='action_refuse']" position="before">
                <button
                    name="action_pay_employee"
                    string="Pay to the Employee"
                    type="object"
                    data-hotkey="g"
                    class="oe_highlight"
                    invisible="not (conciliation_move_id and state == 'in_payment')"
                    groups="account.group_account_invoice"
                />
            </xpath>
        </field>
    </record>
</odoo>
