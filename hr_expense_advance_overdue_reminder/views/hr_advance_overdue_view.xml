<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form view -->
    <record id="hr_advance_overdue_reminder_form" model="ir.ui.view">
        <field name="name">hr.advance.overdue.reminder.form</field>
        <field name="model">hr.advance.overdue.reminder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_submit"
                        type="object"
                        string="Submit"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_validate"
                        type="object"
                        string="Send"
                        class="btn-primary"
                        invisible="state != 'submit'"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state != 'submit'"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'draft'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submit,done"
                    />
                </header>
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="not is_warning_duplicate"
                >
                    <span
                    >WARNING: Some Advance documents are already included in another Overdue Reminder.</span>
                </div>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" class="oe_inline" />
                    </h1>
                    <group name="main">
                        <group name="information_left">
                            <field
                                name="employee_id"
                                readonly="state != 'draft'"
                                required="1"
                            />
                            <field
                                name="employee_work_email"
                                readonly="state != 'draft'"
                                widget="email"
                            />
                            <field
                                name="reminder_definition_id"
                                readonly="state != 'draft'"
                                required="1"
                            />
                            <field
                                name="action_type"
                                readonly="state != 'draft'"
                                required="1"
                            />
                            <field
                                name="mail_template_id"
                                readonly="state != 'draft'"
                                invisible="action_type != 'mail'"
                            />
                        </group>
                        <group name="information_right">
                            <field name="is_warning_duplicate" invisible="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="date" readonly="state != 'draft'" />
                            <field name="user_id" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <notebook>
                        <page name="av_overdue" string="Advance Overdue">
                            <field
                                name="expense_sheet_ids"
                                readonly="state != 'draft'"
                                domain="[('employee_id', '=', employee_id), ('advance', '=', True), ('clearing_date_due', '&lt;', datetime.date.today().strftime('%Y-%m-%d')), ('clearing_residual', '&gt;', 0.0)]"
                            >
                                <list create="0" edit="0">
                                    <field name="number" />
                                    <field name="accounting_date" />
                                    <field name="clearing_date_due" />
                                    <field name="name" string="Order Ref" />
                                    <field name="total_amount" sum="Total" />
                                    <field name="clearing_residual" sum="Total" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <!-- List view -->
    <record id="hr_advance_overdue_reminder_list" model="ir.ui.view">
        <field name="name">hr.advance.overdue.reminder.list</field>
        <field name="model">hr.advance.overdue.reminder</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'">
                <field name="name" />
                <field name="employee_id" />
                <field name="reminder_definition_id" />
                <field name="date" />
                <field name="action_type" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'done'"
                    decoration-info="state == 'draft'"
                />
            </list>
        </field>
    </record>
    <!-- Search view -->
    <record id="hr_advance_overdue_reminder_search" model="ir.ui.view">
        <field name="name">hr.advance.overdue.reminder.search</field>
        <field name="model">hr.advance.overdue.reminder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter name="date_filter" string="Date" date="date" />
                <separator />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="submit"
                    string="Submit"
                    domain="[('state', '=', 'submit')]"
                />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <group name="groupby">
                    <filter
                        name="action_type_groupby"
                        string="Action Type"
                        context="{'group_by': 'action_type'}"
                    />
                    <filter
                        name="employee_groupby"
                        string="Employee"
                        context="{'group_by': 'employee_id'}"
                    />
                    <filter
                        name="reminder_definition_groupby"
                        string="Reminder Definition"
                        context="{'group_by': 'reminder_definition_id'}"
                    />
                    <filter
                        name="state_groupby"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_hr_advance_overdue_reminder" model="ir.actions.act_window">
        <field name="name">Overdue Reminder Action</field>
        <field name="res_model">hr.advance.overdue.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_advance_overdue_reminder_search" />
    </record>

    <!-- Main menu Overdue -->
    <menuitem
        id="menu_hr_expense_overdue"
        name="Employee Overdue"
        sequence="5"
        parent="hr_expense.menu_hr_expense_root"
        groups="hr.group_hr_manager,account.group_account_user"
    />
    <menuitem
        id="menu_advance_overdue_reminder_view"
        name="Overdue Reminder"
        sequence="1"
        action="action_hr_advance_overdue_reminder"
        parent="menu_hr_expense_overdue"
        groups="hr.group_hr_manager,account.group_account_user"
    />
</odoo>
